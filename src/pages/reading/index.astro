---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import EntryList from "../../components/EntryList.astro";
import Preview from "../../components/Preview.astro";
import { entries, readingRows } from "../../lib";
const list = await entries("reading");
---
<Base title="Reading" description="Selected papers and monographs archived for reference. Original attribution preserved.">
  <PageHead n="05" title="Reading" lede="Selected papers and monographs kept for reference. Original attribution preserved." count={list.length} />
  <section class="wrap"><EntryList rows={readingRows(list)} empty="Archive empty." /></section>
  <Preview />
</Base>
