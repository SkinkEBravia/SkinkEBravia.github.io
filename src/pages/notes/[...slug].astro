---
import { render } from "astro:content";
import Article from "../../layouts/Article.astro";
import { entries, fmtDate, readingTime } from "../../lib";

export async function getStaticPaths() {
  return (await entries("notes")).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Article kind="Notes" back="/notes/" title={d.title} description={d.description}
  meta={[d.topic, fmtDate(d.date), `${readingTime(entry.body)} min read`]}>
  <Content />
</Article>
