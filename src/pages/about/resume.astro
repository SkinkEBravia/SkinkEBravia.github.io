---
import Base from "../../layouts/Base.astro";
import ExperimentTables from "../../components/ExperimentTables.astro";
import { site } from "../../site";
import { resume, type ResumeEntry } from "../../resume";

const groups: { n: string; title: string; entries: ResumeEntry[] }[] = [
  { n: "02", title: "Research", entries: [...resume.research] },
  { n: "03", title: "Competitions", entries: [...resume.competitions] },
  { n: "04", title: "Internship", entries: [resume.internship] },
];
---
<Base title="Resume" description={`Resume of ${resume.name}. Bachelor of Engineering, Artificial Intelligence, Lanzhou University.`}>
  <article class="wrap cv">
    <header class="head">
      <a class="label back" href="/about/">← <span data-decode>About</span></a>
      <p class="label">Curriculum vitae · {resume.updated}</p>
      <h1 class="serif" data-reveal>{resume.name}</h1>
      <p class="role serif italic" data-reveal>Bachelor of Engineering · Artificial Intelligence</p>
      <p class="meta label">
        <span>Lanzhou University</span>
        <span>Gansu, China</span>
        <span>{resume.education.when}</span>
        <span>GPA {resume.education.gpa} · Rank {resume.education.rank}</span>
      </p>
      <nav class="links" aria-label="Resume links">
        {site.documents.map((doc) => (
          <a class="pill" href={doc.href} target="_blank" rel="noopener">{doc.label} PDF ↗</a>
        ))}
        <a class="pill" href={resume.publication.href} target="_blank" rel="noopener">Publication ↗</a>
      </nav>
      <p class="contact">
        <a class="ulink" href={resume.phoneHref}>{resume.phone}</a>
        {resume.emails.map((mail) => (
          <a class="ulink mail" href={`mailto:${mail}`}>
            <span class="sep" aria-hidden="true">·</span>{mail}
          </a>
        ))}
      </p>
    </header>

    <section class="group" aria-labelledby="edu">
      <h2 id="edu"><span class="label">01</span> Education</h2>
      <article class="item">
        <h3 class="serif">{resume.education.title}</h3>
        <p class="when label">{resume.education.when}</p>
        {resume.education.context.map((line) => <p class="context">{line}</p>)}
        <p class="context">Cumulative GPA {resume.education.gpa} · Rank {resume.education.rank} (same year, same major)</p>
        <p class="interest"><span class="label">Research interest</span> {resume.education.interest}</p>
      </article>
    </section>

    {groups.map((group) => (
      <section class="group" aria-labelledby={group.n}>
        <h2 id={group.n}><span class="label">{group.n}</span> {group.title}</h2>
        {group.entries.map((entry) => {
          const table = entry.table;
          return (
          <article class="item">
            <h3 class="serif">{entry.title}</h3>
            <p class="when label">{entry.when}</p>
            {entry.context.map((line) => <p class="context">{line}</p>)}
            {entry.points.length > 0 && (
              <ul>
                {entry.points.map((point) => <li>{point}</li>)}
              </ul>
            )}
            {table && <ExperimentTables table={table} />}
          </article>
          );
        })}
      </section>
    ))}

    <section class="group" aria-labelledby="pub">
      <h2 id="pub"><span class="label">05</span> Publication</h2>
      <p class="cite serif">{resume.publication.citation}</p>
      <p class="doi"><a href={resume.publication.href} target="_blank" rel="noopener">DOI {resume.publication.doi} ↗</a></p>
    </section>

    <section class="group" aria-labelledby="honors">
      <h2 id="honors"><span class="label">06</span> Honors</h2>
      <ul class="honors">
        {resume.honors.map((honor) => (
          <li>
            <span>{honor.title}</span>
            <span class="label">{honor.when}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="group" aria-labelledby="skills">
      <h2 id="skills"><span class="label">07</span> Skills</h2>
      <dl class="skills">
        {resume.skills.map((skill) => (
          <div>
            <dt class="label">{skill.label}</dt>
            <dd>{skill.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  </article>
</Base>
<style>
  .cv { padding-top: clamp(130px, 16vw, 210px); display: grid; gap: clamp(56px, 7vw, 88px); padding-bottom: 20px; min-width: 0; }
  .head { display: grid; gap: 20px; padding-bottom: 32px; border-bottom: 1px solid var(--line-2); min-width: 0; }
  .head > * { min-width: 0; max-width: 100%; }
  .back { width: max-content; }
  .back:hover { color: var(--paper); }
  h1 { margin: 0; font-size: clamp(56px, 10vw, 128px); line-height: 0.9; letter-spacing: -0.035em; max-width: 12ch; text-wrap: balance; }
  .role { margin: 0; font-size: clamp(22px, 2.4vw, 34px); color: var(--paper-2); max-width: 22ch; line-height: 1.15; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 0; max-width: 100%; }
  .meta span { white-space: nowrap; flex: none; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; }
  .contact { display: flex; flex-wrap: wrap; gap: 8px 14px; margin: 0; color: var(--paper-2); }
  .mail { display: inline-flex; gap: 8px; align-items: baseline; }
  .group { display: grid; gap: 22px; }
  h2 {
    margin: 0; display: flex; align-items: baseline; gap: 14px;
    font: 400 clamp(36px, 5vw, 64px)/0.95 var(--serif); letter-spacing: -0.03em;
    border-top: 1px solid var(--line-2); padding-top: 18px;
  }
  h2::before { content: "§"; color: var(--hot); font-style: italic; }
  h2 .label { color: var(--dim); }
  .item {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(120px, 190px);
    gap: 8px 28px; padding-bottom: 26px; border-bottom: 1px solid var(--line);
  }
  .item > * { min-width: 0; }
  h3 { margin: 0; grid-column: 1; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.15; letter-spacing: -0.02em; overflow-wrap: break-word; }
  .when { grid-column: 2; grid-row: 1; margin: 0.35em 0 0; text-align: right; }
  .context, .interest, .item ul { grid-column: 1 / -1; }
  .context { margin: 0; font: italic 400 20px/1.35 var(--serif); color: var(--paper-2); }
  .interest { margin: 6px 0 0; max-width: 68ch; color: var(--paper-2); }
  .interest .label { display: block; margin-bottom: 8px; }
  .item ul { margin: 8px 0 0; padding-left: 1.15em; color: var(--paper-2); }
  .item li + li { margin-top: 0.55em; }
  .item li::marker { color: var(--hot); font-family: var(--mono); }
  .cite { margin: 0; max-width: 68ch; font-size: clamp(22px, 2.2vw, 30px); line-height: 1.3; }
  .doi { margin: 0; }
  .doi a { color: var(--paper); background: linear-gradient(var(--hot), var(--hot)) 0 100% / 100% 1px no-repeat; }
  .doi a:hover { color: var(--hot); }
  .honors { list-style: none; margin: 0; padding: 0; }
  .honors li {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px 24px;
    align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--line);
  }
  .skills { margin: 0; display: grid; gap: 22px; }
  .skills div { display: grid; grid-template-columns: minmax(140px, 200px) minmax(0, 1fr); gap: 8px 24px; align-items: baseline; }
  .skills dd { margin: 0; color: var(--paper-2); overflow-wrap: break-word; }
  @media (max-width: 700px) {
    .item, .honors li, .skills div { grid-template-columns: minmax(0, 1fr); }
    .when { grid-column: 1; grid-row: auto; text-align: left; margin-top: 0; }
    .meta { display: grid; gap: 8px; }
    .contact { display: grid; gap: 6px; }
    .sep { display: none; }
  }
</style>
