---
import Base from "./Base.astro";
interface Props { kind: string; back: string; title: string; description?: string; meta: string[] }
const { kind, back, title, description, meta } = Astro.props;
---
<Base title={title} description={description}>
  <article class="wrap art">
    <header class="head">
      <a class="label back" href={back}>← <span data-decode>{kind}</span></a>
      <h1 class="serif" data-reveal>{title}</h1>
      {description && <p class="desc serif italic" data-reveal>{description}</p>}
      <p class="meta label">{meta.map((m) => <span>{m}</span>)}</p>
    </header>
    <div class="prose"><slot /></div>
  </article>
</Base>
<style>
  .art { padding-top: clamp(130px, 16vw, 210px); }
  .head { display: grid; gap: 22px; padding-bottom: 36px; margin-bottom: 56px; border-bottom: 1px solid var(--line-2); }
  .back { width: max-content; }
  .back:hover { color: var(--paper); }
  h1 { margin: 0; font-size: clamp(48px, 8vw, 128px); line-height: 0.92; letter-spacing: -0.025em; max-width: 16ch; text-wrap: balance; }
  .desc { margin: 0; font-size: clamp(22px, 2.3vw, 32px); color: var(--paper-2); max-width: 36ch; line-height: 1.2; }
  .meta { display: flex; gap: 22px; flex-wrap: wrap; margin: 8px 0 0; }
  .prose { padding-left: clamp(0px, 12vw, 200px); }
</style>
