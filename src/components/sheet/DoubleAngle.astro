---
// Double angle on the unit circle. A = (−1, 0), P at 2θ: the inscribed angle at A
// is θ, the central angle at O is 2θ, and APB is a right angle (Thales).
// So AP = 2 cos θ, PB = 2 sin θ, PF = sin 2θ, OF = cos 2θ, AF = 2cos²θ, FB = 2sin²θ.
// Rows light the segments each identity reads off. Drag P.
import Figure from "./Figure.astro";
import { at, deg } from "./geom";
import { layout, U, VB } from "./da";

const L = layout(35 * deg);
const vb = `${VB.x} ${VB.y} ${VB.w} ${VB.h}`;
const LABS = ["lAP", "lPB", "lPF", "lOF", "lOP", "lOA", "lOB", "lAF", "lFB", "lth", "l2th", "lP", "lF", "lO"];
---
<Figure n="07" title="Inscribed" class="da">
  <span slot="hud">θ <b data-theta>35°</b> · 2θ <b data-2theta>70°</b></span>

  <svg class="plot" viewBox={vb} role="img" aria-label="Unit circle, radius 1. From A at minus 1, a chord to P at angle 2 theta makes angle theta at A. The chord AP is 2 cos theta, the perpendicular from P is sin 2 theta, and the foot sits at cos 2 theta.">
    <text class="unit" x={VB.x + 4} y={VB.y + 12}>UNIT CIRCLE · r = 1</text>
    <path class="circ" d={`M${-U} 0 A${U} ${U} 0 0 1 ${U} 0`} />
    <path class="circ low" d={`M${U} 0 A${U} ${U} 0 0 1 ${-U} 0`} />
    <line class="axis" x1={VB.x + 6} y1="0" x2={VB.x + VB.w - 6} y2="0" />
    <polygon class="tri" data-g="triAPF" {...at(L.triAPF)} />

    <line class="seg one" data-s="OA" data-g="OA" {...at(L.OA)} />
    <line class="seg one" data-s="OB" data-g="OB" {...at(L.OB)} />
    <line class="seg rad" data-s="OP" data-g="OP" {...at(L.OP)} />
    <line class="seg chord" data-s="PB" data-g="PB" {...at(L.PB)} />
    <line class="seg ap" data-s="AP" data-g="AP" {...at(L.AP)} />
    <line class="seg of" data-s="OF" data-g="OF" {...at(L.OF)} />
    <line class="seg pf" data-s="PF" data-g="PF" {...at(L.PF)} />
    <path class="br" data-s="AF" data-g="bAF" {...at(L.bAF)} />
    <path class="br" data-s="FB" data-g="bFB" {...at(L.bFB)} />
    <path class="rm" data-g="rF" {...at(L.rF)} />
    <path class="rm" data-g="rP" {...at(L.rP)} />
    <path class="arc th" data-s="th" data-g="arcA" {...at(L.arcA)} />
    <path class="arc" data-g="arcO" {...at(L.arcO)} />

    {LABS.map((l) => <text class="lab" data-g={l} data-l={l} {...at(L[l])}>{L[l].text}</text>)}
    <text class="pt" x={-U - 8} y="18" text-anchor="end">A</text>
    <text class="pt" x={U + 8} y="18">B</text>

    <circle class="dot" r="3.5" cx={-U} cy="0" />
    <circle class="dot" r="3.5" data-g="P" {...at(L.P)} />
    <g class="handle" role="slider" aria-label="Angle 2 theta" aria-valuemin="2" aria-valuemax="178" aria-valuenow="70">
      <circle class="hit" r="20" data-g="handle" {...at(L.handle)} />
      <circle class="ringh" r="9" data-g="handle" {...at(L.handle)} />
    </g>
  </svg>
</Figure>

<script>
  import { mountGlitch } from "../../scripts/glitch";
  import { apply, deg, draggable, onSheet } from "./geom";
  import { layout } from "./da";

  // result (hot) and the pieces it is read from (cyan)
  const ROWS: Record<string, { res: string[]; parts: string[] }> = {
    "1": { res: ["PF", "lPF"], parts: ["AP", "lAP", "th", "lth"] },
    "2": { res: ["OF", "lOF"], parts: ["AF", "lAF", "FB", "lFB"] },
    "3": { res: ["OF", "lOF"], parts: ["AF", "lAF", "OA", "lOA", "AP", "lAP"] },
    "4": { res: ["OF", "lOF"], parts: ["FB", "lFB", "OB", "lOB", "PB", "lPB"] },
  };

  for (const svg of document.querySelectorAll<SVGSVGElement>(".da .plot")) {
    const fig = svg.closest<HTMLElement>(".da")!;
    const tOut = fig.querySelector<HTMLElement>("[data-theta]")!, t2Out = fig.querySelector<HTMLElement>("[data-2theta]")!;
    const handle = svg.querySelector<SVGGElement>(".handle")!;
    const els = svg.querySelectorAll<SVGElement>("[data-s], [data-l]");
    const { burst } = mountGlitch(svg);
    let theta = 35 * deg;

    const draw = () => {
      apply(svg, layout(theta));
      tOut.textContent = `${Math.round(theta / deg)}°`;
      t2Out.textContent = `${Math.round((2 * theta) / deg)}°`;
      handle.setAttribute("aria-valuenow", String(Math.round((2 * theta) / deg)));
    };
    const clamp = (t: number) => Math.max(1 * deg, Math.min(89 * deg, t));
    draggable(svg, handle, (p) => {
      let a = Math.atan2(-p.y, p.x);
      if (a < 0) a = p.x > 0 ? 0 : Math.PI; // stay on the upper half
      theta = clamp(a / 2); draw();
    }, (d, big) => { theta = clamp(theta + d * (big ? 5 : 0.5) * deg); draw(); });

    onSheet(fig, (k) => {
      const r = ROWS[k];
      if (k) fig.dataset.active = k; else delete fig.dataset.active;
      els.forEach((el) => {
        const id = el.dataset.s ?? el.dataset.l!;
        el.classList.toggle("res", !!r?.res.includes(id));
        el.classList.toggle("part", !!r?.parts.includes(id));
      });
      burst(k ? 100 : 50);
    });
    draw();
  }
</script>

<style>
  .plot { width: 100%; height: auto; display: block; margin-top: 8px; overflow: hidden; }
  .unit { fill: var(--dim); font: 500 7.5px var(--mono); letter-spacing: 0.08em; }
  .circ { fill: none; stroke: var(--paper-2); stroke-opacity: 0.55; stroke-width: 1.25; }
  .circ.low { stroke-dasharray: 2 5; stroke-opacity: 0.3; }
  .axis { stroke: var(--line-2); }
  .tri { fill: var(--cyan); opacity: 0.1; }

  .seg { stroke-width: 2; stroke-linecap: round; transition: opacity 0.3s var(--ease), stroke-width 0.3s var(--ease), stroke 0.3s var(--ease); }
  .one { stroke: var(--paper-2); stroke-width: 1; stroke-dasharray: 2 4; }
  .rad { stroke: var(--paper-2); stroke-width: 1.25; }
  .chord { stroke: var(--paper-2); stroke-width: 1.25; stroke-dasharray: 5 4; }
  .ap { stroke: var(--cyan); }
  .of { stroke: var(--paper); stroke-width: 2.5; }
  .pf { stroke: var(--hot); stroke-width: 2.5; }
  .br { fill: none; stroke: var(--dim); stroke-width: 1.1; transition: opacity 0.3s var(--ease); }
  .rm { fill: none; stroke: var(--dim); }
  .arc { fill: none; stroke: var(--paper-2); }
  .arc.th { stroke: var(--cyan); }

  .lab { fill: var(--paper-2); font: italic 400 16px var(--serif); transition: opacity 0.3s var(--ease), fill 0.3s var(--ease); }
  .lab[data-l="lAP"] { fill: var(--cyan); }
  .lab[data-l="lPF"] { fill: var(--hot); }
  .lab[data-l="lOF"] { fill: var(--paper); }
  .lab[data-l="lOA"], .lab[data-l="lOB"], .lab[data-l="lOP"] { font-style: normal; }
  .lab[data-l="lO"] { fill: var(--dim); font: 500 11px var(--mono); }
  .lab[data-l="lOB"], .lab[data-l="lFB"], .lab[data-l="lAF"] { opacity: 0.55; }
  .pt { fill: var(--dim); font: 500 11px var(--mono); }
  .dot { fill: var(--paper); }

  /* rows */
  :global(.da[data-active]) .seg:not(.res):not(.part), :global(.da[data-active]) .br:not(.res):not(.part),
  :global(.da[data-active]) .lab:not(.res):not(.part), :global(.da[data-active]) .tri { opacity: 0.2; }
  .seg.res, .br.res { stroke: var(--hot); stroke-width: 3.5; stroke-dasharray: none; opacity: 1; }
  .seg.part, .br.part { stroke: var(--cyan); stroke-width: 3; stroke-dasharray: none; opacity: 1; }
  .arc.part { stroke-width: 2.5; }
  .lab.res { fill: var(--hot); opacity: 1; } .lab.part { fill: var(--cyan); opacity: 1; }

  .handle { cursor: grab; touch-action: none; outline: none; }
  .handle.is-dragging { cursor: grabbing; }
  .hit { fill: transparent; }
  .ringh { fill: none; stroke: var(--paper); stroke-width: 1.25; stroke-dasharray: 2 3; }
  .handle:hover .ringh, .handle:focus-visible .ringh, .handle.is-dragging .ringh { stroke: var(--cyan); stroke-dasharray: none; }
</style>
