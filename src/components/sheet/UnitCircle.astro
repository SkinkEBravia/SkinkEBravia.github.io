---
// All six functions as lengths on one unit circle, in three similar right triangles:
//   (cos, sin, 1) · (1, tan, sec) · (cot, 1, csc).
// Rows 1–3 each focus one triangle. Drag θ anywhere around the circle.
// Mode "Signs": segments are coloured by sign (cyan +, hot −), the current quadrant
// is lit, and θ turns slowly on its own until you grab it.
import Figure from "./Figure.astro";
import { at, deg, f } from "./geom";
import { layout, VB } from "./uc";

const L = layout(35 * deg);
const vb = `${VB.x} ${VB.y} ${VB.w} ${VB.h}`;
const wedge = (k: number) => {
  const r = 100, a0 = (k * Math.PI) / 2, a1 = a0 + Math.PI / 2;
  return `M0 0 L${f(r * Math.cos(a0))} ${f(-r * Math.sin(a0))} A${r} ${r} 0 0 0 ${f(r * Math.cos(a1))} ${f(-r * Math.sin(a1))} Z`;
};
const SEGS: Record<string, [string, string?][]> = {
  g3: [["oneC"], ["cot", "tan"], ["csc", "sin"]], g2: [["oneB"], ["tan", "tan"], ["sec", "cos"]], g1: [["rad"], ["cos", "cos"], ["sin", "sin"]],
};
const LABS: Record<string, [string, string?][]> = {
  g3: [["lcot", "tan"], ["lcsc", "sin"], ["loneC"]], g2: [["ltan", "tan"], ["lsec", "cos"], ["loneB"]], g1: [["lcos", "cos"], ["lsin", "sin"], ["lone"]],
};
---
<Figure n="03" title="Unit circle" modes={["Lengths", "Signs"]} class="uc">
  <span slot="hud">θ <b data-theta>35°</b><span class="q"> · Q <b data-quad>I</b></span></span>

  <svg class="plot" viewBox={vb} role="img" aria-label="Unit circle with angle theta. Three similar right triangles: legs cos theta and sin theta with hypotenuse 1; legs 1 and tan theta with hypotenuse sec theta on the tangent line x = 1; legs cot theta and 1 with hypotenuse csc theta on the tangent line y = 1.">
    <defs><clipPath id="uc-clip"><rect x={VB.x} y={VB.y} width={VB.w} height={VB.h} /></clipPath></defs>
    <g clip-path="url(#uc-clip)">
      {[0, 1, 2, 3].map((k) => <path class="wedge" data-q={k + 1} d={wedge(k)} />)}
      <line class="axis" x1={VB.x} y1="0" x2={VB.x + VB.w} y2="0" />
      <line class="axis" x1="0" y1={VB.y} x2="0" y2={VB.y + VB.h} />
      <line class="tline" x1="100" y1={VB.y} x2="100" y2={VB.y + VB.h} />
      <line class="tline" x1={VB.x} y1="-100" x2={VB.x + VB.w} y2="-100" />
      <circle class="circ" r="100" />
      <text class="ax" x={VB.x + VB.w - 8} y="-6" text-anchor="end">x</text>
      <text class="ax" x="7" y={VB.y + 14}>y</text>
      <text class="ax" x="104" y={VB.y + VB.h - 8}>x = 1</text>
      <text class="ax" x={VB.x + 8} y="-106">y = 1</text>

      <g class="grp g3" data-key="3">
        <polygon class="tri" data-g="triC" {...at(L.triC)} />
        {SEGS.g3.map(([g, fn]) => <line class="seg" data-g={g} data-fn={fn} {...at(L[g])} />)}
        <path class="rm" data-g="rC" {...at(L.rC)} />
        {LABS.g3.map(([g, fn]) => <text class="lab" data-g={g} data-fn={fn} {...at(L[g])}>{L[g].text}</text>)}
      </g>
      <g class="grp g2" data-key="2">
        <polygon class="tri" data-g="triB" {...at(L.triB)} />
        {SEGS.g2.map(([g, fn]) => <line class="seg" data-g={g} data-fn={fn} {...at(L[g])} />)}
        <path class="rm" data-g="rB" {...at(L.rB)} />
        {LABS.g2.map(([g, fn]) => <text class="lab" data-g={g} data-fn={fn} {...at(L[g])}>{L[g].text}</text>)}
      </g>
      <g class="grp g1" data-key="1">
        <polygon class="tri" data-g="triA" {...at(L.triA)} />
        {SEGS.g1.map(([g, fn]) => <line class="seg" data-g={g} data-fn={fn} {...at(L[g])} />)}
        <path class="rm" data-g="rA" {...at(L.rA)} />
        {LABS.g1.map(([g, fn]) => <text class="lab" data-g={g} data-fn={fn} {...at(L[g])}>{L[g].text}</text>)}
      </g>

      <path class="th-arc" data-g="arc" {...at(L.arc)} />
      <text class="th" data-g="lth" {...at(L.lth)}>θ</text>
      <circle class="pt" r="3.5" data-g="P" {...at(L.P)} />
      <g class="handle" role="slider" aria-label="Angle theta" aria-valuemin="0" aria-valuemax="359" aria-valuenow="35">
        <circle class="hit" r="20" data-g="handle" {...at(L.handle)} />
        <circle class="ringh" r="9" data-g="handle" {...at(L.handle)} />
      </g>
    </g>
  </svg>

  <div class="signs label" aria-live="polite">
    <span data-sg="sin"><b>+</b> sin · csc</span>
    <span data-sg="cos"><b>+</b> cos · sec</span>
    <span data-sg="tan"><b>+</b> tan · cot</span>
  </div>
</Figure>

<script>
  import { reduce } from "../../scripts/decode";
  import { mountGlitch } from "../../scripts/glitch";
  import { apply, deg, draggable, onSheet } from "./geom";
  import { layout, signs } from "./uc";

  for (const svg of document.querySelectorAll<SVGSVGElement>(".uc .plot")) {
    const fig = svg.closest<HTMLElement>(".uc")!;
    const thetaOut = fig.querySelector<HTMLElement>("[data-theta]")!;
    const quadOut = fig.querySelector<HTMLElement>("[data-quad]")!;
    const handle = svg.querySelector<SVGGElement>(".handle")!;
    const wedges = svg.querySelectorAll<SVGPathElement>(".wedge");
    const fnEls = svg.querySelectorAll<SVGElement>("[data-fn]");
    const chips = fig.querySelectorAll<HTMLElement>("[data-sg]");
    const { burst } = mountGlitch(svg);

    let theta = 35 * deg, quad = 1;
    const norm = (a: number) => ((a % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI);

    const draw = () => {
      apply(svg, layout(theta));
      const d = Math.round(norm(theta) / deg) % 360;
      thetaOut.textContent = `${d}°`;
      handle.setAttribute("aria-valuenow", String(d));
      const q = Math.floor(norm(theta) / (Math.PI / 2)) + 1;
      if (q !== quad) { quad = q; if (fig.dataset.mode === "1") burst(80); }
      quadOut.textContent = ["I", "II", "III", "IV"][q - 1];
      wedges.forEach((w) => w.classList.toggle("on", +w.dataset.q! === q));
      const sg = signs(theta);
      fnEls.forEach((el) => el.classList.toggle("neg", !sg[el.dataset.fn as "sin" | "cos" | "tan"]));
      chips.forEach((c) => {
        const pos = sg[c.dataset.sg as "sin" | "cos" | "tan"];
        c.classList.toggle("neg", !pos);
        c.querySelector("b")!.textContent = pos ? "+" : "−";
      });
    };

    // drag θ; after letting go, the Signs view resumes turning
    let held = 0;
    draggable(svg, handle, (p) => { theta = Math.atan2(-p.y, p.x); held = performance.now(); draw(); },
      (dir, big) => { theta += dir * (big ? 15 : 1) * deg; held = performance.now(); draw(); });

    // slow turn in Signs mode, only while visible
    let visible = false, raf = 0, last = 0;
    const tick = (now: number) => {
      const dt = Math.min(64, now - last); last = now;
      if (fig.dataset.mode === "1" && visible && !handle.classList.contains("is-dragging") && now - held > 2500) {
        theta += (dt / 16000) * 2 * Math.PI; draw();
      }
      raf = fig.dataset.mode === "1" && visible ? requestAnimationFrame(tick) : 0;
    };
    const run = () => { if (!reduce && !raf && fig.dataset.mode === "1" && visible) { last = performance.now(); raf = requestAnimationFrame(tick); } };
    new IntersectionObserver((es) => { visible = es.some((e) => e.isIntersecting); run(); }).observe(svg);
    fig.addEventListener("figure:mode", () => { burst(140); draw(); run(); });

    onSheet(fig, (k) => { if (k) fig.dataset.active = k; else delete fig.dataset.active; burst(k ? 100 : 50); });
    draw();
  }
</script>

<style>
  .plot { width: 100%; height: auto; display: block; margin-top: 8px; }
  .axis { stroke: var(--line-2); }
  .tline { stroke: var(--line-2); stroke-dasharray: 2 5; }
  .circ { fill: none; stroke: var(--paper-2); stroke-opacity: 0.55; stroke-width: 1.25; }
  .ax { fill: var(--dim); font: 500 10px var(--mono); letter-spacing: 0.06em; }
  .wedge { fill: var(--paper); opacity: 0; transition: opacity 0.4s var(--ease); }
  :global(.uc[data-mode="1"]) .wedge.on { opacity: 0.07; }

  .grp { transition: opacity 0.35s var(--ease); cursor: default; }
  :global(.uc[data-active]) .grp:not([data-on]) { opacity: 0.07; }
  .tri { stroke: none; opacity: 0.1; transition: opacity 0.35s var(--ease); }
  .grp[data-on] .tri { opacity: 0.22; }
  .g1 .tri { fill: var(--paper); } .g2 .tri { fill: var(--cyan); } .g3 .tri { fill: var(--hot); }
  :global(.uc[data-mode="1"]) .tri { fill: var(--paper); opacity: 0.05; }

  .seg { stroke-width: 2; stroke-linecap: round; transition: stroke 0.3s var(--ease); }
  .g1 .seg { stroke: var(--paper); } .g2 .seg { stroke: var(--cyan); } .g3 .seg { stroke: var(--hot); }
  .seg[data-g^="one"], .seg[data-g="rad"] { stroke: var(--paper-2); stroke-width: 1.1; stroke-dasharray: 3 3; }
  .seg[data-g="rad"] { stroke-dasharray: none; }
  .lab { font: italic 400 16px var(--serif); dominant-baseline: auto; transition: fill 0.3s var(--ease), opacity 0.2s; }
  .g1 .lab { fill: var(--paper); } .g2 .lab { fill: var(--cyan); } .g3 .lab { fill: var(--hot); }
  .lab[data-g^="lone"] { fill: var(--paper-2); font-style: normal; }
  .lab[data-g="loneB"], .lab[data-g="loneC"] { visibility: hidden; }
  .grp[data-on] .lab[data-g="loneB"], .grp[data-on] .lab[data-g="loneC"] { visibility: visible; }
  .rm { fill: none; stroke: var(--paper-2); stroke-width: 1; }

  /* signs view: colour is the sign, not the triangle */
  :global(.uc[data-mode="1"]) .seg[data-fn] { stroke: var(--cyan); }
  :global(.uc[data-mode="1"]) .seg[data-fn].neg { stroke: var(--hot); }
  :global(.uc[data-mode="1"]) .lab[data-fn] { fill: var(--cyan); }
  :global(.uc[data-mode="1"]) .lab[data-fn].neg { fill: var(--hot); }

  .th-arc { fill: none; stroke: var(--paper-2); }
  .th { fill: var(--paper-2); font: italic 400 15px var(--serif); text-anchor: middle; dominant-baseline: central; }
  .pt { fill: var(--paper); }
  .handle { cursor: grab; touch-action: none; outline: none; }
  .handle.is-dragging { cursor: grabbing; }
  .hit { fill: transparent; }
  .ringh { fill: none; stroke: var(--paper); stroke-width: 1.25; stroke-dasharray: 2 3; }
  .handle:hover .ringh, .handle:focus-visible .ringh, .handle.is-dragging .ringh { stroke: var(--cyan); stroke-dasharray: none; }

  .q { display: none; }
  :global(.uc[data-mode="1"]) .q { display: inline; }
  .signs { display: none; gap: 8px 18px; flex-wrap: wrap; margin-top: 10px; }
  :global(.uc[data-mode="1"]) .signs { display: flex; }
  .signs span { display: inline-flex; gap: 8px; align-items: center; color: var(--paper-2); text-transform: none; }
  .signs b { display: inline-grid; place-items: center; width: 18px; height: 18px; border: 1px solid var(--cyan); color: var(--cyan); font-weight: 500; }
  .signs .neg b { border-color: var(--hot); color: var(--hot); }
</style>
