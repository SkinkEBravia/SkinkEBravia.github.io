---
// The trig hexagon: 1 in the centre, sin cos / tan · cot / sec csc around it.
// Each shaded, downward triangle is one Pythagorean identity:
// top-left² + top-right² = bottom². The key beside it shows that rule alone.
// Meant to sit inside <Sheet>; triangle n is linked to list item n.
const R = 150;
const H = (R * Math.sqrt(3)) / 2;
const P = {
  sin: [-R / 2, -H], cos: [R / 2, -H],
  tan: [-R, 0], one: [0, 0], cot: [R, 0],
  sec: [-R / 2, H], csc: [R / 2, H],
} as const;
type Name = keyof typeof P;
const label = (n: Name) => (n === "one" ? "1" : n);

// [top-left, top-right, bottom]
const tris: [Name, Name, Name][] = [["sin", "cos", "one"], ["tan", "one", "sec"], ["one", "cot", "csc"]];
const NODE = 27;

const roles = (n: Name) =>
  Object.fromEntries(tris.map((t, i) => [`data-r${i + 1}`, t[0] === n ? "a" : t[1] === n ? "b" : t[2] === n ? "c" : undefined]));

const glyphs = tris.map(([a, b, c], i) => {
  const mx = (P[a][0] + P[b][0]) / 2, my = P[a][1];
  const y0 = my + 13, y1 = P[c][1] - NODE - 6;
  return { k: String(i + 1), mx, my, y0, y1, ym: (y0 + y1) / 2 };
});

const ticks = Array.from({ length: 72 }, (_, i) => {
  const deg = i * 5, t = (deg * Math.PI) / 180;
  const len = deg % 60 === 0 ? 13 : deg % 30 === 0 ? 8 : 3.5;
  const r0 = 184, r1 = r0 - len;
  return { x0: r0 * Math.cos(t), y0: r0 * Math.sin(t), x1: r1 * Math.cos(t), y1: r1 * Math.sin(t), major: deg % 60 === 0 };
});
const f = (x: number) => x.toFixed(2);
const pts = (ns: Name[]) => ns.map((n) => `${f(P[n][0])},${f(P[n][1])}`).join(" ");
const hexagon = pts(["sin", "cos", "cot", "csc", "sec", "tan"]);

// legend: the same triangle with placeholders
const L = { a: [-62, -40], b: [62, -40], c: [0, 67.4] } as const;
const LN = 22;
---
<figure class="hx" data-hexfig data-reveal>
  <figcaption class="hud label">
    <span>Fig 01 · Hexagon</span>
    <span>Tri <b data-readout>--</b> / 03</span>
  </figcaption>

  <div class="stage">
    <svg class="hex" viewBox="-198 -198 396 396" role="img" aria-labelledby="hx-title hx-desc">
      <title id="hx-title">Trig identity hexagon</title>
      <desc id="hx-desc">A hexagon with 1 in the centre. Top row sin and cos, middle row tan, 1 and cot, bottom row sec and csc. Three shaded downward triangles, (sin, cos, 1), (tan, 1, sec) and (1, cot, csc), each read as top-left squared plus top-right squared equals bottom squared.</desc>
      <defs>
        <linearGradient id="hx-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="st-cyan" stop-opacity="0.34" />
          <stop offset="0.55" class="st-cyan" stop-opacity="0.1" />
          <stop offset="1" class="st-hot" stop-opacity="0.2" />
        </linearGradient>
        <filter id="hx-tint-hot" x="-5%" y="-5%" width="110%" height="110%">
          <feColorMatrix type="luminanceToAlpha" result="lum" />
          <feComponentTransfer in="lum" result="key"><feFuncA type="linear" slope="1.6" /></feComponentTransfer>
          <feFlood class="fl-hot" />
          <feComposite in2="key" operator="in" />
        </filter>
        <filter id="hx-tint-cyan" x="-5%" y="-5%" width="110%" height="110%">
          <feColorMatrix type="luminanceToAlpha" result="lum" />
          <feComponentTransfer in="lum" result="key"><feFuncA type="linear" slope="1.6" /></feComponentTransfer>
          <feFlood class="fl-cyan" />
          <feComposite in2="key" operator="in" />
        </filter>
        <clipPath id="hx-bands">{[0, 1, 2, 3, 4].map(() => <rect x="-198" width="396" y="0" height="0" />)}</clipPath>
        <clipPath id="hx-tear">{[0, 1].map(() => <rect x="-198" width="396" y="0" height="0" />)}</clipPath>
      </defs>

      <g id="hx-art">
        <g class="ring">
          <circle r="184" />
          {ticks.map((t) => <line class:list={{ major: t.major }} x1={f(t.x0)} y1={f(t.y0)} x2={f(t.x1)} y2={f(t.y1)} />)}
        </g>
        <polygon class="outline" points={hexagon} />
        <g class="spokes">
          {([["sin", "csc"], ["cos", "sec"], ["tan", "cot"]] as [Name, Name][]).map(([a, b]) =>
            <line x1={f(P[a][0])} y1={f(P[a][1])} x2={f(P[b][0])} y2={f(P[b][1])} />)}
        </g>

        {tris.map((t, i) => <polygon class="tri" data-key={String(i + 1)} points={pts(t)} />)}

        {glyphs.map((g) => (
          <g class="glyph" data-k={g.k}>
            <line x1={f(g.mx)} y1={f(g.y0)} x2={f(g.mx)} y2={f(g.y1)} />
            <path d={`M${f(g.mx - 5)} ${f(g.y1 - 6)} L${f(g.mx)} ${f(g.y1)} L${f(g.mx + 5)} ${f(g.y1 - 6)}`} />
            <circle class="bub plus" cx={f(g.mx)} cy={f(g.my)} r="11" />
            <text class="op" x={f(g.mx)} y={f(g.my)}>+</text>
            <circle class="bub eq" cx={f(g.mx)} cy={f(g.ym)} r="11" />
            <text class="op" x={f(g.mx)} y={f(g.ym)}>=</text>
          </g>
        ))}
        {glyphs.map((g) => <text class="idx" data-k={g.k} x={f(g.mx)} y={f(g.ym)}>{`0${g.k}`}</text>)}

        {(Object.keys(P) as Name[]).map((n) => (
          <g class:list={["node", { one: n === "one" }]} {...roles(n)}>
            <circle class="disc" cx={f(P[n][0])} cy={f(P[n][1])} r={NODE} />
            <text class="name" x={f(P[n][0])} y={f(P[n][1])}>{label(n)}</text>
            <text class="sq" x={f(P[n][0] + NODE * 0.78)} y={f(P[n][1] - NODE * 0.78)}>2</text>
          </g>
        ))}
      </g>

      <g class="ghost" aria-hidden="true">
        <g clip-path="url(#hx-tear)">
          <rect class="tear-bg" x="-198" y="-198" width="396" height="396" />
          <use href="#hx-art" />
        </g>
        <g clip-path="url(#hx-bands)" class="split">
          <use href="#hx-art" filter="url(#hx-tint-hot)" />
          <use href="#hx-art" filter="url(#hx-tint-cyan)" />
        </g>
      </g>
    </svg>

    <div class="key">
      <span class="label">Key</span>
      <svg class="legend" viewBox="-96 -76 192 172" role="img" aria-label="Key: top-left squared plus top-right squared equals bottom squared.">
        <defs>
          <linearGradient id="hx-key-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" class="st-cyan" stop-opacity="0.34" />
            <stop offset="0.55" class="st-cyan" stop-opacity="0.1" />
            <stop offset="1" class="st-hot" stop-opacity="0.2" />
          </linearGradient>
        </defs>
        <polygon class="tri key-tri" points={`${L.a} ${L.b} ${L.c}`} />
        <g class="glyph on">
          <line x1="0" y1={L.a[1] + 13} x2="0" y2={L.c[1] - LN - 6} />
          <path d={`M-5 ${L.c[1] - LN - 12} L0 ${L.c[1] - LN - 6} L5 ${L.c[1] - LN - 12}`} />
          <circle class="bub plus" cx="0" cy={L.a[1]} r="11" />
          <text class="op" x="0" y={L.a[1]}>+</text>
          <circle class="bub eq" cx="0" cy={(L.a[1] + 13 + L.c[1] - LN - 6) / 2} r="11" />
          <text class="op" x="0" y={(L.a[1] + 13 + L.c[1] - LN - 6) / 2}>=</text>
        </g>
        {(["a", "b", "c"] as const).map((r) => (
          <g class="node on" data-role={r}>
            <circle class="disc" cx={L[r][0]} cy={L[r][1]} r={LN} />
            <text class="name" data-slot={r} x={L[r][0]} y={L[r][1]}>{r}</text>
            <text class="sq" x={L[r][0] + LN * 0.8} y={L[r][1] - LN * 0.8}>2</text>
          </g>
        ))}
      </svg>
    </div>
  </div>
</figure>

<script>
  import { decode, reduce } from "../../scripts/decode";

  const TRIS = [["sin", "cos", "1"], ["tan", "1", "sec"], ["1", "cot", "csc"]];
  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  for (const fig of document.querySelectorAll<HTMLElement>("[data-hexfig]")) {
    const svg = fig.querySelector<SVGSVGElement>(".hex")!;
    const ghost = svg.querySelector<SVGGElement>(".ghost")!;
    const bands = svg.querySelectorAll<SVGRectElement>("#hx-bands rect");
    const tears = svg.querySelectorAll<SVGRectElement>("#hx-tear rect");
    const [tearUse] = svg.querySelectorAll<SVGUseElement>(".ghost > g:first-child use");
    const [hotUse, cyanUse] = svg.querySelectorAll<SVGUseElement>(".split use");
    const readout = fig.querySelector<HTMLElement>("[data-readout]")!;
    const slots = fig.querySelectorAll<SVGTextElement>(".legend [data-slot]");

    // Chroma split and slice tears, reseeded every second frame so the blocks
    // read as codec errors rather than noise.
    let until = 0, raf = 0, frame = 0;
    const band = (r: SVGRectElement, hMin: number, hMax: number) => {
      r.setAttribute("y", rand(-198, 170).toFixed(1));
      r.setAttribute("height", rand(hMin, hMax).toFixed(1));
    };
    const step = (now: number) => {
      if (now >= until) { ghost.style.opacity = "0"; raf = 0; return; }
      if (frame++ % 2 === 0) {
        bands.forEach((r) => band(r, 4, 42));
        tears.forEach((r) => band(r, 3, 18));
        const dx = rand(3, 11) * (Math.random() < 0.5 ? -1 : 1);
        hotUse.setAttribute("transform", `translate(${dx.toFixed(1)} 0)`);
        cyanUse.setAttribute("transform", `translate(${(-dx * 0.8).toFixed(1)} 0)`);
        tearUse.setAttribute("transform", `translate(${rand(-24, 24).toFixed(1)} 0)`);
        ghost.style.opacity = "1";
      }
      raf = requestAnimationFrame(step);
    };
    const burst = (ms: number) => {
      if (reduce) return;
      until = Math.max(until, performance.now() + ms);
      if (!raf) { frame = 0; raf = requestAnimationFrame(step); }
    };

    // one burst when the figure first arrives on screen
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(() => burst(560), 280); }
    }, { threshold: 0.5 });
    io.observe(fig);

    fig.closest("[data-sheet]")?.addEventListener("sheet:active", (e) => {
      const k = (e as CustomEvent<string>).detail;
      if (k) fig.dataset.active = k; else delete fig.dataset.active;
      readout.textContent = k ? k.padStart(2, "0") : "--";
      const names = k ? TRIS[+k - 1] : ["a", "b", "c"];
      slots.forEach((el, i) => {
        el.classList.toggle("up", names[i] === "1");
        el.dataset.decodeText = names[i];
        if (reduce) el.textContent = names[i]; else decode(el, 320);
      });
      burst(k ? 110 : 60);
    });
  }
</script>

<style>
  .hx {
    position: relative;
    margin: 0 !important;
    max-width: none !important;
    padding: clamp(14px, 2vw, 22px);
    border: 1px solid var(--line);
    background:
      repeating-linear-gradient(to bottom, color-mix(in srgb, var(--paper) 2.5%, transparent) 0 1px, transparent 1px 3px),
      radial-gradient(90% 70% at 42% 22%, color-mix(in srgb, var(--cyan) 7%, transparent), transparent 62%),
      radial-gradient(70% 55% at 62% 104%, color-mix(in srgb, var(--hot) 6%, transparent), transparent 70%),
      var(--ink-2);
  }
  /* crop marks */
  .hx::before, .hx::after {
    content: ""; position: absolute; width: 12px; height: 12px; pointer-events: none;
    border: 0 solid var(--paper-2);
  }
  .hx::before { left: -1px; top: -1px; border-left-width: 1px; border-top-width: 1px; }
  .hx::after { right: -1px; bottom: -1px; border-right-width: 1px; border-bottom-width: 1px; }

  .hud { display: flex; justify-content: space-between; gap: 12px; margin: 0 !important; }
  .hud b { color: var(--paper); font-weight: 500; }
  .hx[data-active] .hud b { color: var(--hot); }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 8px;
  }
  .hex { width: 100%; max-width: 500px; height: auto; justify-self: center; overflow: visible; touch-action: manipulation; }
  .key { display: grid; gap: 6px; justify-items: start; padding-bottom: 6px; }
  .legend { width: 148px; height: auto; overflow: visible; }
  @media (max-width: 620px) {
    .stage { grid-template-columns: 1fr; }
    .key {
      grid-template-columns: auto auto; align-items: center; justify-content: center; gap: 16px;
      padding-top: 14px; border-top: 1px solid var(--line);
    }
    .legend { width: 124px; }
  }

  /* ---- drawing */
  .st-cyan { stop-color: var(--cyan); }
  .st-hot { stop-color: var(--hot); }
  .fl-hot { flood-color: var(--hot); }
  .fl-cyan { flood-color: var(--cyan); }

  .ring circle { fill: none; stroke: var(--line); }
  .ring line { stroke: var(--line-2); stroke-width: 1; }
  .ring line.major { stroke: var(--paper-2); stroke-opacity: 0.5; }
  .outline { fill: none; stroke: var(--line-2); stroke-width: 1.25; }
  .spokes line { stroke: var(--line-2); stroke-dasharray: 1.5 5; }

  .tri {
    fill: url(#hx-fill);
    stroke: var(--cyan); stroke-opacity: 0.75; stroke-width: 1.25; stroke-linejoin: round;
    fill-opacity: 0.8;
    cursor: pointer;
    transition: fill-opacity 0.4s var(--ease), stroke-opacity 0.4s var(--ease);
  }
  .key-tri { fill: url(#hx-key-fill); cursor: default; }
  .hx[data-active] .hex .tri { fill-opacity: 0.25; stroke-opacity: 0.25; }
  .hx[data-active] .hex .tri[data-on] { fill-opacity: 1; stroke-opacity: 1; }

  .glyph { opacity: 0; transition: opacity 0.3s var(--ease-snap); pointer-events: none; }
  .glyph line, .glyph path { fill: none; stroke: var(--paper-2); stroke-width: 1.1; }
  .bub { fill: var(--ink); stroke-width: 1.1; }
  .bub.plus { stroke: var(--cyan); }
  .bub.eq { stroke: var(--paper-2); }
  .op { fill: var(--paper); font: 500 14px var(--mono); text-anchor: middle; dominant-baseline: central; }
  .idx {
    fill: var(--dim); font: 500 10px var(--mono); letter-spacing: 0.08em;
    text-anchor: middle; dominant-baseline: central; pointer-events: none;
    transition: opacity 0.3s var(--ease-snap);
  }

  .node { pointer-events: none; }
  .disc { fill: var(--ink-3); stroke: var(--line-2); stroke-width: 1.25; transition: stroke 0.3s var(--ease), fill 0.3s var(--ease); }
  .one .disc { stroke: var(--paper-2); stroke-width: 1.5; }
  .name {
    fill: var(--paper); font: italic 400 25px var(--serif);
    text-anchor: middle; dominant-baseline: central;
    transition: opacity 0.3s var(--ease);
  }
  .one .name, .name.up { font-style: normal; font-size: 30px; }
  .legend .name { font-size: 23px; }
  .legend .name.up { font-size: 26px; }
  .sq {
    font: 400 16px var(--serif); text-anchor: middle; dominant-baseline: central;
    opacity: 0; transition: opacity 0.3s var(--ease-snap);
  }

  /* the key is always "on": cyan corners on top, hot corner at the bottom */
  .legend .glyph { opacity: 1; }
  .legend .sq { opacity: 1; }
  .legend [data-role="a"] .disc, .legend [data-role="b"] .disc { stroke: var(--cyan); }
  .legend [data-role="c"] .disc { stroke: var(--hot); }
  .legend [data-role="a"] .sq, .legend [data-role="b"] .sq { fill: var(--cyan); }
  .legend [data-role="c"] .sq { fill: var(--hot); }

  /* the active triangle in the hexagon turns into the key */
  .hx[data-active="1"] .glyph[data-k="1"], .hx[data-active="2"] .glyph[data-k="2"], .hx[data-active="3"] .glyph[data-k="3"] { opacity: 1; }
  .hx[data-active="1"] .idx[data-k="1"], .hx[data-active="2"] .idx[data-k="2"], .hx[data-active="3"] .idx[data-k="3"] { opacity: 0; }
  .hx[data-active="1"] .hex .node:not([data-r1]) .name,
  .hx[data-active="2"] .hex .node:not([data-r2]) .name,
  .hx[data-active="3"] .hex .node:not([data-r3]) .name { opacity: 0.35; }
  .hx[data-active="1"] [data-r1] .sq, .hx[data-active="2"] [data-r2] .sq, .hx[data-active="3"] [data-r3] .sq { opacity: 1; }
  .hx[data-active="1"] [data-r1="a"] .disc, .hx[data-active="1"] [data-r1="b"] .disc,
  .hx[data-active="2"] [data-r2="a"] .disc, .hx[data-active="2"] [data-r2="b"] .disc,
  .hx[data-active="3"] [data-r3="a"] .disc, .hx[data-active="3"] [data-r3="b"] .disc { stroke: var(--cyan); }
  .hx[data-active="1"] [data-r1="a"] .sq, .hx[data-active="1"] [data-r1="b"] .sq,
  .hx[data-active="2"] [data-r2="a"] .sq, .hx[data-active="2"] [data-r2="b"] .sq,
  .hx[data-active="3"] [data-r3="a"] .sq, .hx[data-active="3"] [data-r3="b"] .sq { fill: var(--cyan); }
  .hx[data-active="1"] [data-r1="c"] .disc, .hx[data-active="2"] [data-r2="c"] .disc, .hx[data-active="3"] [data-r3="c"] .disc { stroke: var(--hot); }
  .hx[data-active="1"] [data-r1="c"] .sq, .hx[data-active="2"] [data-r2="c"] .sq, .hx[data-active="3"] [data-r3="c"] .sq { fill: var(--hot); }

  /* glitch layers, hidden unless a burst is running */
  .ghost { opacity: 0; pointer-events: none; }
  .tear-bg { fill: var(--ink-2); }
  .split use { mix-blend-mode: screen; opacity: 0.8; }
</style>
