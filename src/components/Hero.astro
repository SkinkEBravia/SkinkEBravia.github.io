---
import { site } from "../site";
---
<section class="hero" aria-label="Introduction">
  <canvas id="signal" aria-hidden="true"></canvas>
  <div class="fallback" aria-hidden="true"></div>

  <div class="hud hud-top label">
    <span>Computer graphics<br />Rendering<br />Visual effects</span>
    <span class="r">Signal <b data-fps>—</b> fps<br />Seed <b data-seed>0x000000</b><br /><b data-state>Nominal</b></span>
  </div>

  <div class="stage">
    <p class="tagline serif italic" data-reveal>{site.tagline}</p>
    <h1 class="name">
      <span class="glitch" data-signal data-text={site.name}>{site.name}</span>
    </h1>
  </div>

  <div class="hud hud-bottom label">
    <span>Scroll <span class="arrow">↓</span></span>
    <span class="r">SDF · Raymarch · WebGL2</span>
  </div>
</section>

<script>
  import { mountSignal } from "../scripts/hero-gl";
  const canvas = document.getElementById("signal") as HTMLCanvasElement;
  const name = document.querySelector<HTMLElement>(".hero .glitch")!;
  const state = document.querySelector<HTMLElement>("[data-state]")!;
  const seed = document.querySelector<HTMLElement>("[data-seed]")!;
  addEventListener("signal:burst", (e) => {
    const on = (e as CustomEvent<boolean>).detail;
    name.classList.toggle("is-glitching", on);
    state.textContent = on ? "Corrupt" : "Nominal";
    state.classList.toggle("hot", on);
    if (on) seed.textContent = "0x" + ((Math.random() * 0xffffff) | 0).toString(16).toUpperCase().padStart(6, "0");
  });
  try { mountSignal(canvas); } catch (err) { console.warn(err); canvas.dataset.fallback = "true"; }

  // fps readout
  const fpsEl = document.querySelector<HTMLElement>("[data-fps]")!;
  let n = 0, t = performance.now();
  const tick = (now: number) => {
    n++;
    if (now - t > 500) { fpsEl.textContent = String(Math.round((n * 1000) / (now - t))); n = 0; t = now; }
    requestAnimationFrame(tick);
  };
  requestAnimationFrame(tick);
</script>

<style>
  .hero {
    position: relative;
    height: 100svh; min-height: 600px;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 84px var(--gutter) 22px;
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0; transition: opacity 1.6s var(--ease); image-rendering: auto; }
  canvas:global(.is-live) { opacity: 1; }
  .fallback {
    position: absolute; inset: 0; z-index: -2;
    background:
      radial-gradient(40% 50% at 50% 48%, rgb(255 46 99 / .25), transparent 70%),
      radial-gradient(30% 40% at 56% 44%, rgb(39 230 255 / .18), transparent 70%),
      var(--ink);
  }
  .hud { min-width: 0; display: flex; justify-content: space-between; gap: 20px; color: rgb(236 235 230 / .6); }
  .hud b { color: var(--paper); font-weight: 500; }
  .r { text-align: right; }
  .stage { align-self: end; display: grid; gap: 10px; min-width: 0; container-type: inline-size; mix-blend-mode: difference; color: #fff; }
  .tagline { justify-self: end; max-width: 22ch; margin: 0; font-size: clamp(20px, 2.1vw, 30px); line-height: 1.1; text-align: right; }
  .name {
    margin: 0;
    font: 900 calc(100cqi / 8.14)/0.86 var(--display);
    letter-spacing: -0.055em;
    white-space: nowrap;
    margin-left: -0.05em;
  }
  .hud-bottom { margin-top: 18px; padding-top: 14px; border-top: 1px solid rgb(236 235 230 / .16); }
  .arrow { display: inline-block; animation: bob 1.8s var(--ease) infinite; }
  @keyframes bob { 50% { transform: translateY(4px); } }
</style>
